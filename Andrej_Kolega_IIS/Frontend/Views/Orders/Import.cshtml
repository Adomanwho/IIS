@model OrderImportViewModel
@{
    ViewData["Title"] = "Import Orders";
}

<h1 class="h3 mb-3">Import Orders</h1>
<p class="text-muted">Upload an XML or JSON file with one or more orders. The file is validated against the order XSD or JSON Schema before being saved.</p>

<div class="card mb-4">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form asp-controller="Orders" asp-action="Import" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Order file (.xml or .json)</label>
                <input type="file" name="File" class="form-control" accept=".xml,.json" required />
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
        </form>
    </div>
</div>

@if (Model.Result is not null)
{
    if (Model.Result.Success)
    {
        <div class="alert alert-success">
            Successfully saved @Model.Result.SavedCount order(s).
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <p class="mb-2"><strong>Validation failed:</strong></p>
            <ul class="mb-0">
                @foreach (var error in Model.Result.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
}
