@model OrdersManageViewModel
@{
    ViewData["Title"] = "Manage Orders";
}

<h1 class="h3 mb-3">Manage Orders</h1>

<p>
    Data source:
    <span class="badge @(Model.Mode == "Custom" ? "bg-primary" : "bg-secondary")">@Model.Mode REST API</span>
    <span class="text-muted">
        (set <code>OrdersApi:Mode</code> to <code>Public</code> or <code>Custom</code> in appsettings.json to switch)
    </span>
</p>

@if (ViewData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Mode == "Custom")
{
    if (User.IsInRole("FullAccess"))
    {
        <a asp-controller="OrdersManage" asp-action="Create" class="btn btn-primary mb-3">Create order</a>
    }

    <table class="table table-striped bg-white">
        <thead>
            <tr>
                <th>Id</th>
                <th>Customer</th>
                <th>Status</th>
                <th>City</th>
                <th>Date</th>
                <th>Items</th>
                @if (User.IsInRole("FullAccess"))
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.CustomOrders ?? new())
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.CustomerName</td>
                    <td>@order.Status</td>
                    <td>@order.ShippingCity</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@order.Items.Count</td>
                    @if (User.IsInRole("FullAccess"))
                    {
                        <td class="text-end">
                            <a asp-controller="OrdersManage" asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-controller="OrdersManage" asp-action="DeleteViaGraphQl" asp-route-id="@order.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Deletes via a GraphQL mutation">Delete (GraphQL)</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">
        Read-only view of the public REST API (Firebase). Switch <code>OrdersApi:Mode</code> to <code>Custom</code>
        to browse and manage the SQL-backed orders (create/edit via REST, delete via GraphQL).
    </p>

    <table class="table table-striped bg-white">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Status</th>
                <th>City</th>
                <th>Date</th>
                <th>Items</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.PublicOrders ?? new())
            {
                <tr>
                    <td>@order.CustomerName</td>
                    <td>@order.Status</td>
                    <td>@order.ShippingCity</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@order.Items.Count</td>
                </tr>
            }
        </tbody>
    </table>
}
